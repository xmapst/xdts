# 复制为 /etc/xdts/manager.env 并限制为 root/xdts 可读。
XDTS_DATABASE_DSN=xdts_manager:change-me@tcp(127.0.0.1:3306)/xdts_manager?parseTime=true\&loc=UTC\&charset=utf8mb4
XDTS_AMQP_URL=amqps://xdts_manager:change-me@rabbitmq.example.com:5671/xdts
XDTS_AUTH_LOCAL_BOOTSTRAP_USER=admin
XDTS_AUTH_LOCAL_BOOTSTRAP_PASSWORD=change-me
